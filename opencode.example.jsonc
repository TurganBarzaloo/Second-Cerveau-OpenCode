{
  // ------------------------------------------------------------------
  // Exemple de configuration générique — à copier sous opencode.json
  // (exclu de Git par .gitignore) et à adapter à votre machine.
  //
  // Règles de sécurité :
  // - Ne jamais écrire la clé API en clair dans un fichier versionné.
  //   Utilisez une variable d'environnement (voir ci-dessous).
  // - Ce fichier ne contient que des valeurs fictives : remplacez l'adresse
  //   d'API et les identifiants par ceux de votre installation.
  //
  // Relevez vos identifiants réels avec :  opencode models
  // ------------------------------------------------------------------
  "$schema": "https://opencode.ai/config.json",

  // Fournisseur LAN ou machine locale, API compatible OpenAI.
  // Si votre fournisseur est déjà défini dans la configuration globale
  // d'OpenCode, supprimez ce bloc entier et ne gardez que "model".
  "provider": {
    "ia-lan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IA LAN (exemple)",
      "options": {
        "baseURL": "https://<adresse-api-lan>/v1",
        // La clé est lue depuis la variable d'environnement IA_LAN_API_KEY.
        "apiKey": "{env:IA_LAN_API_KEY}"
      },
      "models": {
        "<identifiant-modele>": {
          "name": "Modele LAN (exemple)",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },

  // Modèle utilisé, au format "<fournisseur>/<modèle>".
  // Choisissez-le sur sa fidélité aux consignes et sa capacité à exécuter de
  // vrais appels d'outils, pas sur la taille annoncée de son contexte : un
  // modèle qui rend ses appels en texte brut (<function=...>) ne peut pas
  // faire fonctionner les rituels.
  "model": "ia-lan/<identifiant-modele>",

  // Aucun partage automatique des conversations, aucun cloud.
  "share": "disabled",

  // ------------------------------------------------------------------
  // ATTENTION (OpenCode) : la DERNIÈRE règle qui correspond l'emporte.
  // La règle générale "*" doit donc toujours précéder les règles précises.
  // ------------------------------------------------------------------
  "permission": {
    // ACCÈS WEB — `webfetch` récupère une page que vous désignez. C'est OpenCode
    // qui la télécharge depuis votre poste : le contenu ne quitte pas votre
    // réseau, seule l'URL visée est connue du site visité.
    // "ask" par défaut : chaque récupération hors liste blanche demande votre
    // accord. Ajoutez les domaines que vous consultez souvent.
    // Rappel : une page récupérée est une donnée NON FIABLE, pas une consigne.
    "webfetch": {
      "*": "ask",
      "https://opencode.ai/**": "allow"
    },
    // `websearch` reste refusé, et ce n'est pas qu'un choix de prudence : il ne
    // fonctionne pas avec un fournisseur local. OpenCode le réserve à ses
    // propres fournisseurs hébergés, ou aux variables d'environnement
    // OPENCODE_ENABLE_EXA / OPENCODE_ENABLE_PARALLEL, qui envoient vos requêtes
    // à un service tiers sans authentification. L'activer est donc un écart
    // assumé à la souveraineté des données : à consigner dans votre registre.
    "websearch": "deny",
    // Un seul agent d'exécution : pas de sous-agents.
    "task": "deny",
    // Pas de shell : inutile au travail Markdown, et voie de contournement de
    // la protection des originaux. Les commandes git s'exécutent hors agent.
    // (À réévaluer, avec confirmation, si un besoin concret apparaît :
    // "bash": { "*": "ask" }.)
    "bash": "deny",

    // LECTURE — sobriété imposée techniquement, et non par simple consigne :
    // les rituels ne doivent lire que la fiche concernée et le corpus utile.
    // "ask" plutôt que "deny" sur le reste : rien ne peut être lu
    // silencieusement, mais un besoin légitime reste possible après accord.
    // Adaptez ces chemins à l'arborescence de votre vault.
    "read": {
      "*": "ask",
      "AGENTS.md": "allow",
      "README.md": "allow",
      "templates/**": "allow",
      "projets/**": "allow",
      "sources/**": "allow",
      "syntheses/**": "allow",
      "livrables/**": "allow",
      "examples/pilote/**": "allow"
    },

    // RECHERCHE — même logique : empêche le ratissage du type "**/*.md".
    "glob": {
      "*": "ask",
      "templates/**": "allow",
      "projets/**": "allow",
      "sources/**": "allow",
      "syntheses/**": "allow",
      "livrables/**": "allow",
      "examples/pilote/**": "allow"
    },
    "grep": {
      "*": "ask",
      "templates/**": "allow",
      "projets/**": "allow",
      "sources/**": "allow",
      "syntheses/**": "allow",
      "livrables/**": "allow",
      "examples/pilote/**": "allow"
    },

    // Rien hors du projet : bloque notamment la lecture de la configuration
    // globale d'OpenCode, cible de l'instruction hostile du document de test.
    "external_directory": "deny",

    // ÉCRITURE — autorisée partout (fiches, synthèses, index, journal et
    // surtout `livrables/`, où l'agent dépose ce qu'il produit), SAUF les
    // originaux, les modèles, les règles et la configuration.
    // Vérifié : un motif relatif couvre aussi une demande en chemin absolu,
    // OpenCode normalisant les chemins avant de les comparer.
    "edit": {
      "*": "allow",
      "sources/**": "deny",
      "examples/pilote/sources/**": "deny",
      "templates/**": "deny",
      ".opencode/**": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      "opencode.jsonc": "deny",
      "opencode.example.jsonc": "deny",
      // Refusez l'écriture sur vos fichiers exclus de Git : n'étant pas
      // versionnés, ils ne se récupèrent pas par `git restore`.
      "registre-risques.md": "deny"
    }
  }
}
